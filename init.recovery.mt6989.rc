# PD2430 (vivo S20 Pro / mt6989) recovery init
# USB / vold 部分参考真机 mt6989 树（realme RE6022L1）

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1
    exec - root root -- /system/bin/sh /system/bin/loadmods.sh

on fs
    install_keyring

on early-fs
    start vold

on late-fs
    mount_all /first_stage_ramdisk/fstab.mt6989 --late

on boot
    start health-hal-2-1

import /init.recovery.touch.rc
